                  "type": "string",
                },
                "minItems": 1,
                "type": "array",
              },
              "required": {
                "default": false,
                "description": "Required for every kind",
                "type": "boolean",
              },
              "requiredFor": {
                "default": [],
                "description": "Kinds that require this field",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
            },
            "type": "object",
          },
          "default": {},
          "description": "Custom frontmatter fields",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string",
          },
          "type": "object",
        },
        "kinds": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "bump": {
                "description": "Version level this kind triggers",
                "enum": [
                  "none",
                  "patch",
                  "minor",
                  "major",
                ],
                "type": "string",
              },
              "notes": {
                "default": true,
                "description": "Include this kind in release notes",
